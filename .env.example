# ==============================================================================
# SMART AGRICULTURE IOT DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. In Local Development: Copy this file to .env.local and populate with your credentials.
#    NEVER commit .env.local to version control (.gitignore protects it).
# 2. In Vercel Deployment:
#    Add each required variable under Vercel Project Settings -> Environment Variables.
#    IMPORTANT: After adding or changing environment variables in Vercel, you MUST
#    trigger a new deployment (Redeploy in Vercel or push a commit) so the Serverless
#    runtime picks up the updated environment variables.
# 3. Security:
#    - NEVER prefix server secrets with NEXT_PUBLIC_
#    - Only browser-safe variables (URL, anon key, camera local URLs) use NEXT_PUBLIC_
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database, Auth & Realtime
# ------------------------------------------------------------------------------
# Dashboard API HTTPS URL
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project URL
# Environments: Production, Preview, Development
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Client-safe Anon Key (RLS-enforced, public read/subscribe access)
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
# Environments: Production, Preview, Development
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-only Service Role Secret Key (Bypasses RLS, used exclusively in server Route Handlers)
# WARNING: NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
# Environments: Production, Preview, Development (Server runtime only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. ESP32 Hardware Ingestion Authentication
# ------------------------------------------------------------------------------
# Pre-shared authentication secret sent in "x-device-secret" HTTP header by ESP32
# Where to find: Generate a 32+ character random hex string (e.g. `openssl rand -hex 32`)
#                and configure the exact same string in your ESP32 Arduino sketch.
# WARNING: Server-only secret, never expose to browser.
# Environments: Production, Preview, Development
DEVICE_SHARED_SECRET=generate_a_secure_random_hex_key_here_for_esp32_auth

# Default target hardware device identifier
# Environments: Production, Preview, Development
DEFAULT_DEVICE_ID=ESP32-AGRI-01

# ------------------------------------------------------------------------------
# 3. ESP32-CAM Configuration
# ------------------------------------------------------------------------------
# MJPEG live stream endpoint URL
# Where to find: The local LAN address of the ESP32-CAM (e.g. port 81) or an authenticated
#                tunnel URL (Tailscale, Cloudflare Tunnel, ngrok) for remote HTTPS viewing.
# Environments: Production, Preview, Development
NEXT_PUBLIC_CAMERA_STREAM_URL=http://192.168.1.150:81/stream

# Snapshot capture endpoint URL
# Where to find: The HTTP capture endpoint of ESP32-CAM or secure tunnel endpoint.
# Environments: Production, Preview, Development
NEXT_PUBLIC_CAMERA_CAPTURE_URL=http://192.168.1.150/capture

# ------------------------------------------------------------------------------
# 4. Telegram Notification & Alert Integration
# ------------------------------------------------------------------------------
# Telegram Bot API Token
# Where to find: Open Telegram, talk to @BotFather, create a bot (/newbot) and copy HTTP API token.
# WARNING: Server-only secret, never expose to browser.
# Environments: Production, Preview, Development (Server runtime only)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# Target Telegram Chat ID / Channel ID for notifications
# Where to find: Send a message to your bot or use @userinfobot to get your numeric Telegram user ID.
# Environments: Production, Preview, Development (Server runtime only)
TELEGRAM_CHAT_ID=123456789
